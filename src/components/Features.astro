---
import { Palette, Users, GitFork } from "lucide-react";

const features = [
  {
    icon: Palette,
    title: "Freedom to Create",
    description:
      "Create the worlds you dream of, not just the ones you can afford.",
    color: "text-[#0077B6]",
  },
  {
    icon: Users,
    title: "Powered by the Community",
    description:
      "Uniting scenes, assets, and tools from creators everywhere into one creative universe.",
    color: "text-[#FFD100]",
  },
  {
    icon: GitFork,
    title: "Open by Design",
    description:
      "Built on open principles: transparent, accessible, and welcoming to everyone who wants to create.",
    color: "text-[#5C0A98]",
  },
];
---

<section
  class="py-20 bg-[#2C2C2C] bg-[radial-gradient(#1C1C1C,transparent_1px)] [background-size:16px_16px]"
>
  <div class="container mx-auto px-4">
    <h2 class="text-4xl font-bold mb-12 text-center">What We Strive For</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {
        features.map((feature) => (
          <div class="backdrop-blur-md bg-white/5 rounded-2xl p-6 flex flex-col items-center text-center hover:bg-white/10 transition-colors duration-300">
            <feature.icon className={`h-12 w-12 mb-4 ${feature.color}`} />
            <h3 class="text-2xl font-semibold mb-4">{feature.title}</h3>
            <p class="text-gray-300">{feature.description}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
