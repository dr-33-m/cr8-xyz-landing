---
import { Card } from "@/components/ui/card";
import { Sparkles, Film, HandHeart } from "lucide-react";
---

<section class="py-24 px-6 relative overflow-hidden">
  <div
    class="absolute inset-0 -z-10 bg-gradient-to-b from-secondary/40 via-background to-background"
  >
  </div>

  <div class="max-w-7xl mx-auto relative z-10">
    <div class="text-center mb-16 space-y-4">
      <h2 class="text-3xl md:text-5xl font-medium">What Inspires Us</h2>
      <p class="text-muted-foreground text-lg max-w-2xl mx-auto">
        Our approach is guided by three core principles
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-6 lg:gap-8">
      <Card
        className="p-8 space-y-4 border-border/50 hover:border-primary/50 transition-all hover:shadow-lg group"
      >
        <div
          class="inline-flex items-center justify-center w-12 h-12 rounded-lg mb-2 group-hover:scale-110 transition-transform bg-primary/10"
        >
          <HandHeart className="w-6 h-6 text-primary" />
        </div>
        <h3 class="text-xl font-semibold">Real Stories, Told With Care</h3>
        <p class="text-muted-foreground leading-relaxed">
          Giving light to the genuine stories fashion quietly carries.
        </p>
      </Card>

      <Card
        className="p-8 space-y-4 border-border/50 hover:border-primary/50 transition-all hover:shadow-lg group"
      >
        <div
          class="inline-flex items-center justify-center w-12 h-12 rounded-lg mb-2 group-hover:scale-110 transition-transform bg-primary/10"
        >
          <Film className="w-6 h-6 text-primary" />
        </div>
        <h3 class="text-xl font-semibold">The Spirit of Storytelling</h3>
        <p class="text-muted-foreground leading-relaxed">
          Garments are storytelling tools. They build worlds, shape emotion, and
          carry meaning that lasts long after they're worn.
        </p>
      </Card>

      <Card
        className="p-8 space-y-4 border-border/50 hover:border-primary/50 transition-all hover:shadow-lg group"
      >
        <div
          class="inline-flex items-center justify-center w-12 h-12 rounded-lg mb-2 group-hover:scale-110 transition-transform bg-primary/10"
        >
          <Sparkles className="w-6 h-6 text-primary" />
        </div>
        <h3 class="text-xl font-semibold">A Return to Feeling</h3>
        <p class="text-muted-foreground leading-relaxed">
          We're exhausted by ads. We crave the raw emotion of great cinema
          stories that make us believe. We're bringing that wonder, imagination,
          and feeling back to fashion.
        </p>
      </Card>
    </div>
  </div>
</section>
