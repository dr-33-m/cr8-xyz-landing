---
import { Card } from "@/components/ui/card";
import { Sparkles, HandHeart, Blend } from "lucide-react";
---

<section class="py-24 px-6 relative overflow-hidden">
  <div
    class="absolute inset-0 -z-10 bg-gradient-to-b from-secondary/40 via-background to-background"
  >
  </div>

  <div class="max-w-7xl mx-auto relative z-10">
    <div class="text-center mb-16 space-y-4">
      <h2 class="text-3xl md:text-5xl font-medium">What We've Learned</h2>
      <p class="text-muted-foreground text-lg max-w-2xl mx-auto">
        To grow a great brand:
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-6 lg:gap-8">
      <Card
        className="p-8 space-y-4 border-border/50 hover:border-primary/50 transition-all hover:shadow-lg group"
      >
        <div
          class="inline-flex items-center justify-center w-12 h-12 rounded-lg mb-2 group-hover:scale-110 transition-transform bg-primary/10"
        >
          <HandHeart className="w-6 h-6 text-primary" />
        </div>
        <h3 class="text-xl font-semibold">Care</h3>
        <p class="text-muted-foreground leading-relaxed">
          Care about your community, not just what you can get from them.
        </p>
      </Card>

      <Card
        className="p-8 space-y-4 border-border/50 hover:border-primary/50 transition-all hover:shadow-lg group"
      >
        <div
          class="inline-flex items-center justify-center w-12 h-12 rounded-lg mb-2 group-hover:scale-110 transition-transform bg-primary/10"
        >
          <Blend className="w-6 h-6 text-primary" />
        </div>
        <h3 class="text-xl font-semibold">Connection</h3>
        <p class="text-muted-foreground leading-relaxed">
          Pay attention to your community, not trends.
        </p>
      </Card>

      <Card
        className="p-8 space-y-4 border-border/50 hover:border-primary/50 transition-all hover:shadow-lg group"
      >
        <div
          class="inline-flex items-center justify-center w-12 h-12 rounded-lg mb-2 group-hover:scale-110 transition-transform bg-primary/10"
        >
          <Sparkles className="w-6 h-6 text-primary" />
        </div>
        <h3 class="text-xl font-semibold">Inspiration</h3>
        <p class="text-muted-foreground leading-relaxed">
          Don't sell to people, inspire them.
        </p>
      </Card>
    </div>
  </div>
</section>
