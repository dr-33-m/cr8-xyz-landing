---
import logo from "@/assets/cr8-xyz-transparent.png";

const links = [
  { label: "GitHub", href: "https://github.com/dr-33-m/cr8-app", external: true },
  { label: "Blender", href: "https://www.blender.org/", external: true },
  { label: "Author", href: "https://thamsanqa.africa", external: true },
];
---

<footer class="border-t border-border bg-background px-6 pb-28 pt-9">
  <div class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-4">
    <div class="flex items-center gap-2.5">
      <img src={logo.src} alt="" width="36" height="36" class="size-9 rounded-md object-contain" />
      <span class="font-serif font-semibold text-foreground">Cr8-xyz</span>
      <span class="font-mono text-[11px] text-muted-foreground">· the simpler way to create CGI</span>
    </div>

    <nav class="flex gap-5 text-[13px]" aria-label="Footer navigation">
      {
        links.map((link) => (
          <a
            href={link.href}
            target={link.external ? "_blank" : undefined}
            rel={link.external ? "noreferrer" : undefined}
            class="text-muted-foreground transition-colors hover:text-foreground"
          >
            {link.label}
          </a>
        ))
      }
    </nav>
  </div>
</footer>
