---
import { Button } from "@/components/ui/button";
import { ArrowRight } from "lucide-react";
---

<section
  class="py-24 px-6 relative overflow-hidden bg-foreground text-background"
>
  <div
    class="absolute inset-0 -z-10 opacity-30"
    style="background-image: radial-gradient(circle at 1px 1px, var(--primary) 1px, transparent 0); background-size: 40px 40px;"
  >
  </div>
  <div
    class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] rounded-full opacity-20 blur-3xl"
    style="background: radial-gradient(circle, var(--primary) 0%, transparent 70%);"
  >
  </div>

  <div class="max-w-4xl mx-auto text-center space-y-8 relative z-10">
    <h2 class="text-3xl md:text-5xl font-medium">Begin the First Chapter</h2>
    <p class="text-lg md:text-xl opacity-80 leading-relaxed max-w-2xl mx-auto">
      This is your invitation to begin again, to tell stories that speak to the
      heart, not the market.
    </p>

    <div class="pt-4">
      <a href="/docs">
        <Button
          size="lg"
          className="text-base px-8 py-6 rounded-lg group bg-background text-foreground hover:bg-background/90"
        >
          Begin Your Story
          <ArrowRight
            className="ml-2 w-4 h-4 group-hover:translate-x-1 transition-transform"
          />
        </Button>
      </a>
    </div>
  </div>
</section>
