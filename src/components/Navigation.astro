---
import { Button } from "@/components/ui/button";
import { ArrowRight } from "lucide-react";

const { showButton = true } = Astro.props;
---

<nav class="absolute top-0 left-0 right-0 z-20">
  <div class="container mx-auto px-4 py-4">
    <div class="flex justify-between items-center">
      <div class="flex items-center">
        <a href="/" class="flex items-center">
          <img
            src="/images/cr8.png"
            alt=""
            class="h-10 w-10 transition-transform hover:translate-y-[-2px] rounded-sm"
            style="box-shadow: 0 1px 4px #0077B6;"
          />
          <span class="ml-2 text-xl font-semibold">Cr8-xyz</span>
        </a>
      </div>
      <div class="hidden md:flex">
        <span
          class="bg-white/10 text-[#0077B6] px-4 py-2 rounded-md font-semibold"
        >
          OSS
        </span>
      </div>
      {
        showButton && (
          <a href="/docs">
            <Button className="bg-[#0077B6]/20 text-white hover:bg-[#0077B6]/30 border border-transparent transition-all duration-300 hover:-translate-y-[2px] [box-shadow:0_1px_4px_#0077B6]">
              Set It Up
              <ArrowRight className="h-5 w-5" />
            </Button>
          </a>
        )
      }
    </div>
  </div>
</nav>
