---
import { Goal } from "lucide-react";

const mission = {
  text: "To unite the world’s creative works into one open platform that makes world-class cinematics possible for brands.",
};
---

<section
  class="py-20 bg-[radial-gradient(#000000,transparent_1px)] [background-size:16px_16px]"
>
  <div class="container mx-auto px-4">
    <h2 class="text-4xl font-bold mb-12 text-center">Our Mission</h2>
    <div class="backdrop-blur-md bg-white/5 rounded-2xl p-12 text-center">
      <Goal className="h-12 w-12 mb-6 text-[#0077B6] mx-auto" />
      <p class="text-2xl text-gray-300">{mission.text}</p>
    </div>
  </div>
</section>
