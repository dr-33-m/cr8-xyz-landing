---
import Layout from "./Layout.astro";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<Layout title={title}>
  <main class="min-h-screen">
    <!-- Hero Section -->
    <section
      class="min-h-[40vh] flex items-center justify-center px-6 py-20 relative overflow-hidden"
    >
      <div
        class="absolute inset-0 -z-10 bg-gradient-to-b from-background via-background to-secondary/20"
      >
      </div>
      <div class="absolute inset-0 -z-10">
        <div
          class="absolute top-1/4 left-1/4 w-[500px] h-[500px] rounded-full opacity-20"
          style="background: radial-gradient(circle, var(--primary) 0%, transparent 70%);"
        >
        </div>
        <div
          class="absolute bottom-1/4 right-1/4 w-[500px] h-[500px] rounded-full opacity-20"
          style="background: radial-gradient(circle, var(--primary) 0%, transparent 70%);"
        >
        </div>
      </div>
      <div
        class="absolute inset-0 -z-10"
        style="background-image: radial-gradient(circle at 1px 1px, var(--border) 1px, transparent 0); background-size: 40px 40px;"
      >
      </div>

      <div class="max-w-4xl mx-auto text-center space-y-6">
        <h1
          class="text-4xl md:text-6xl lg:text-7xl font-medium tracking-tight leading-[1.1]"
        >
          {title}
        </h1>
        <p class="text-lg md:text-xl text-muted-foreground max-w-3xl mx-auto">
          Complete guide to setting up and using Cr8-xyz
        </p>
      </div>
    </section>

    <!-- Content Section -->
    <section class="py-24 px-6 relative">
      <div class="max-w-4xl mx-auto">
        <div class="prose prose-lg max-w-none">
          <slot />
        </div>
      </div>
    </section>
  </main>
</Layout>

<style is:global>
  /* Prose styles for documentation */
  .prose {
    max-width: none;
  }

  .prose h1 {
    @apply text-4xl md:text-5xl font-medium mt-12 mb-6 tracking-tight;
  }

  .prose h2 {
    @apply text-3xl md:text-4xl font-medium mt-12 mb-6 border-b border-border pb-4;
  }

  .prose h3 {
    @apply text-2xl font-medium mt-8 mb-4;
  }

  .prose h4 {
    @apply text-xl font-medium mt-6 mb-3;
  }

  .prose p {
    @apply text-muted-foreground leading-relaxed mb-4;
  }

  .prose code:not(pre code) {
    @apply bg-secondary px-2 py-1 rounded text-primary text-sm font-mono;
  }

  .prose pre {
    @apply bg-secondary border border-border rounded-lg p-4 overflow-x-auto mb-6;
  }

  .prose pre code {
    @apply text-foreground text-sm font-mono;
  }

  .prose blockquote {
    @apply border-l-4 border-primary pl-4 py-3 rounded-r-lg my-6;
    background-color: color-mix(in oklch, var(--primary) 10%, transparent);
  }

  .prose blockquote p {
    @apply text-foreground mb-0;
  }

  .prose ul,
  .prose ol {
    @apply text-foreground mb-4 ml-6;
  }

  .prose li {
    @apply mb-2;
  }

  .prose a {
    @apply text-primary underline transition-colors;
  }

  .prose a:hover {
    color: color-mix(in oklch, var(--primary) 80%, var(--background));
  }

  .prose strong {
    @apply font-semibold text-foreground;
  }

  .prose hr {
    @apply border-border my-12;
  }

  .prose li > p {
    @apply mb-1;
  }

  .prose li > code {
    @apply bg-secondary;
  }

  .prose table {
    @apply w-full border-collapse;
  }

  .prose table th {
    @apply bg-secondary border border-border px-4 py-2 text-left font-semibold;
  }

  .prose table td {
    @apply border border-border px-4 py-2;
  }

  .prose table tr:nth-child(even) {
    background-color: color-mix(in oklch, var(--secondary) 50%, transparent);
  }
</style>
