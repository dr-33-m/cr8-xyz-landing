---
import Layout from "../../layouts/Layout.astro";
import Navigation from "../../components/Navigation.astro";
import { Settings, Users, ArrowRight, ExternalLink } from "lucide-react";
---

<Layout title="Cr8-xyz Documentation">
  <div class="min-h-screen bg-[#1C1C1C] text-white flex flex-col relative">
    <div
      class="absolute inset-0 bg-[radial-gradient(#000000,transparent_1px)] [background-size:16px_16px] z-0"
    >
    </div>
    <Navigation showButton={false} />
    <div
      class="container mx-auto px-4 pt-20 flex-1 flex items-center justify-center relative z-10"
    >
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-12">
          <h1
            class="text-3xl md:text-5xl font-bold mb-6 bg-gradient-to-r from-blue-400 to-purple-400 bg-clip-text text-transparent"
          >
            Cr8-xyz Documentation
          </h1>
          <p class="text-lg md:text-xl text-gray-300">
            Everything you need to get started with the Cr8-xyz platform
          </p>
        </div>

        <div class="grid md:grid-cols-2 gap-8">
          <!-- Guided Setup Card -->
          <a
            href="https://cal.com/thamsanqa.dev/cr8-xyz-set-up"
            target="_blank"
            class="group block h-full"
          >
            <div
              class="bg-gray-800/50 backdrop-blur-sm rounded-2xl p-8 border border-gray-700/50 hover:border-yellow-500/50 transition-all duration-300 hover:transform hover:scale-[1.02] h-full flex flex-col"
            >
              <div class="text-center mb-6">
                <div
                  class="w-16 h-16 bg-yellow-600/20 rounded-2xl flex items-center justify-center mx-auto mb-4 group-hover:bg-yellow-600/30 transition-colors"
                >
                  <Users className="w-8 h-8 text-yellow-400" />
                </div>
                <h3
                  class="text-xl font-semibold text-white mb-2 group-hover:text-yellow-400 transition-colors"
                >
                  Let's Set It Up Together!
                </h3>
              </div>
              <p
                class="text-gray-400 text-center mb-6 leading-relaxed flex-grow"
              >
                We believe in connections with people. Pick a time that works
                for you, and we'll walk through Cr8-xyz setup together, just
                people geeking out over 3D possibilities!
              </p>
              <div
                class="flex items-center justify-center text-yellow-400 group-hover:text-yellow-300 transition-colors"
              >
                <span class="mr-2">Pick Time Slot</span>
                <ExternalLink className="w-4 h-4" />
              </div>
            </div>
          </a>

          <!-- Technical Setup Card -->
          <a href="/docs/setup" class="group block h-full">
            <div
              class="bg-gray-800/50 backdrop-blur-sm rounded-2xl p-8 border border-gray-700/50 hover:border-blue-500/50 transition-all duration-300 hover:transform hover:scale-[1.02] h-full flex flex-col"
            >
              <div class="text-center mb-6">
                <div
                  class="w-16 h-16 bg-blue-600/20 rounded-2xl flex items-center justify-center mx-auto mb-4 group-hover:bg-blue-600/30 transition-colors"
                >
                  <Settings className="w-8 h-8 text-blue-400" />
                </div>
                <h3
                  class="text-xl font-semibold text-white mb-2 group-hover:text-blue-400 transition-colors"
                >
                  Technical Setup
                </h3>
              </div>
              <p
                class="text-gray-400 text-center mb-6 leading-relaxed flex-grow"
              >
                Complete technical guide for developers and advanced users who
                want to set up Cr8-xyz from scratch.
              </p>
              <div
                class="flex items-center justify-center text-blue-400 group-hover:text-blue-300 transition-colors"
              >
                <span class="mr-2">Step by Step</span>
                <ArrowRight className="w-4 h-4" />
              </div>
            </div>
          </a>
        </div>

        <!-- Quick Links -->
        <div class="mt-12 text-center">
          <h3 class="text-2xl font-bold mb-6 text-white">Quick Links</h3>
          <div class="flex flex-wrap justify-center gap-4">
            <a
              href="https://discord.gg/VSzupp9wfc"
              class="bg-gray-800 hover:bg-gray-700 px-4 py-2 rounded-lg text-blue-400 hover:text-blue-300 transition-colors"
              target="_blank"
            >
              Community
            </a>
            <a
              href="https://code.streetcrisis.online/Cr8-xyz/cr8-app/issues"
              class="bg-gray-800 hover:bg-gray-700 px-4 py-2 rounded-lg text-blue-400 hover:text-blue-300 transition-colors"
              target="_blank"
            >
              Report Issues
            </a>
            <a
              href="https://code.streetcrisis.online/Cr8-xyz/blender/src/branch/webrtc-viewport-streaming/"
              class="bg-gray-800 hover:bg-gray-700 px-4 py-2 rounded-lg text-blue-400 hover:text-blue-300 transition-colors"
              target="_blank"
            >
              Custom Blender
            </a>
            <a
              href="https://code.streetcrisis.online/Cr8-xyz/cr8-app"
              class="bg-gray-800 hover:bg-gray-700 px-4 py-2 rounded-lg text-blue-400 hover:text-blue-300 transition-colors"
              target="_blank"
            >
              Source Code
            </a>
          </div>
        </div>

        <!-- Early Development Notice -->
        <div class="mt-12">
          <div
            class="bg-gradient-to-r from-amber-600/20 to-orange-600/20 backdrop-blur-sm rounded-2xl p-8 border border-amber-500/30"
          >
            <div class="text-center">
              <div class="flex items-center justify-center mb-4">
                <span class="text-2xl mr-3">🚀</span>
                <h3 class="text-xl font-bold text-amber-300">
                  Early Days - Build With Us
                </h3>
              </div>
              <div class="space-y-4 text-gray-200 leading-relaxed">
                <p>
                  <strong class="text-amber-300"
                    >We're building something special.</strong
                  >
                  Simplified 3D content creation for Everyone. Cr8-xyz is in early
                  development, so expect occasional hiccups along with exciting updates
                  as we perfect the experience.
                </p>
                <p class="text-amber-200 font-medium">
                  <strong>Come build with us.</strong> Through Feedback, Community,
                  and Code!
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>
