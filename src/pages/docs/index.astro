---
import Layout from "../../layouts/Layout.astro";
import { Card } from "@/components/ui/card";
import { Button } from "@/components/ui/button";
import {
  Settings,
  Users,
  ArrowRight,
  ExternalLink,
  ArrowLeft,
} from "lucide-react";
---

<Layout title="Cr8-xyz Documentation">
  <main class="min-h-screen">
    <!-- Hero Section -->
    <section
      class="min-h-[60vh] flex items-center justify-center px-6 py-20 relative overflow-hidden"
    >
      <div
        class="absolute inset-0 -z-10 bg-gradient-to-b from-background via-background to-secondary/20"
      >
      </div>
      <div class="absolute inset-0 -z-10">
        <div
          class="absolute top-1/4 left-1/4 w-[500px] h-[500px] rounded-full opacity-20"
          style="background: radial-gradient(circle, var(--primary) 0%, transparent 70%);"
        >
        </div>
        <div
          class="absolute bottom-1/4 right-1/4 w-[500px] h-[500px] rounded-full opacity-20"
          style="background: radial-gradient(circle, var(--primary) 0%, transparent 70%);"
        >
        </div>
      </div>
      <div
        class="absolute inset-0 -z-10"
        style="background-image: radial-gradient(circle at 1px 1px, var(--border) 1px, transparent 0); background-size: 40px 40px;"
      >
      </div>

      <div class="max-w-4xl mx-auto text-center space-y-8 w-full">
        <div class="flex items-start justify-between gap-8">
          <div class="space-y-4 flex-1">
            <h1
              class="text-4xl md:text-6xl lg:text-7xl font-medium tracking-tight leading-[1.1]"
            >
              Where Fashion Stories Come to Life
            </h1>
            <p
              class="text-lg md:text-xl text-muted-foreground max-w-3xl mx-auto leading-relaxed"
            >
              Your brand has stories waiting to be told. Cr8-xyz gives you the
              tools to transform those narratives into compelling visual
              experiences that resonate with your audience.
            </p>
          </div>
        </div>
        <div class="flex justify-center">
          <a href="/">
            <Button
              variant="outline"
              className="h-auto py-4 px-6 flex items-center gap-2 whitespace-nowrap"
            >
              <ArrowLeft className="w-4 h-4" />
              <span class="text-sm">Home</span>
            </Button>
          </a>
        </div>
      </div>
    </section>

    <!-- Documentation Cards Section -->
    <section class="py-24 px-6 relative">
      <div class="max-w-7xl mx-auto">
        <div class="text-center mb-16 space-y-4">
          <h2 class="text-3xl md:text-5xl font-medium">Choose Your Path</h2>
          <p class="text-muted-foreground text-lg max-w-2xl mx-auto">
            Whether you're starting fresh or scaling your creative process
          </p>
        </div>

        <div class="grid md:grid-cols-2 gap-8 lg:gap-10">
          <!-- Guided Setup Card -->
          <a
            href="https://cal.com/thamsanqa.dev/cr8-xyz-set-up"
            target="_blank"
            class="group block h-full"
          >
            <Card
              className="p-8 space-y-6 border-border/50 hover:border-primary/50 transition-all hover:shadow-lg h-full flex flex-col"
            >
              <div
                class="w-16 h-16 bg-primary/10 rounded-lg flex items-center justify-center group-hover:scale-110 transition-transform"
              >
                <Users className="w-8 h-8 text-primary" />
              </div>
              <div class="space-y-3 flex-grow">
                <h3 class="text-2xl font-semibold">
                  Brand Storytelling Session
                </h3>
                <p class="text-muted-foreground leading-relaxed">
                  Let's craft your brand's unique narrative together. We'll help
                  you translate your fashion vision into stories that connect
                  emotionally with your customers and showcase your collections
                  in their best light.
                </p>
              </div>
              <div
                class="flex items-center text-primary group-hover:text-primary/80 transition-colors"
              >
                <span class="mr-2">Schedule Session</span>
                <ExternalLink className="w-4 h-4" />
              </div>
            </Card>
          </a>

          <!-- Technical Setup Card -->
          <a href="/docs/setup" class="group block h-full">
            <Card
              className="p-8 space-y-6 border-border/50 hover:border-primary/50 transition-all hover:shadow-lg h-full flex flex-col"
            >
              <div
                class="w-16 h-16 bg-primary/10 rounded-lg flex items-center justify-center group-hover:scale-110 transition-transform"
              >
                <Settings className="w-8 h-8 text-primary" />
              </div>
              <div class="space-y-3 flex-grow">
                <h3 class="text-2xl font-semibold">Self-Guided Journey</h3>
                <p class="text-muted-foreground leading-relaxed">
                  For brands ready to take control of their storytelling. We've
                  prepared a comprehensive guide to get cr8-xyz running on your
                  laptop.
                </p>
              </div>
              <div
                class="flex items-center text-primary group-hover:text-primary/80 transition-colors"
              >
                <span class="mr-2">Explore Setup</span>
                <ArrowRight className="w-4 h-4" />
              </div>
            </Card>
          </a>
        </div>
      </div>
    </section>

    <!-- Quick Links Section -->
    <section class="py-24 px-6 relative">
      <div class="max-w-7xl mx-auto">
        <div class="text-center mb-12 space-y-4">
          <h2 class="text-3xl md:text-5xl font-medium">Resources</h2>
          <p class="text-muted-foreground text-lg max-w-2xl mx-auto">
            Everything you need to elevate your brand storytelling
          </p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-4">
          <a href="https://discord.gg/VSzupp9wfc" target="_blank">
            <Button
              variant="outline"
              className="h-auto py-4 px-6 flex flex-col items-center justify-center gap-2"
            >
              <span class="text-lg">Creative Community</span>
              <span class="text-xs text-muted-foreground">Join Discord</span>
            </Button>
          </a>
          <a
            href="https://code.cr8-xyz.art/Cr8-xyz/cr8-app/issues"
            target="_blank"
          >
            <Button
              variant="outline"
              className="h-auto py-4 px-6 flex flex-col items-center justify-center gap-2"
            >
              <span class="text-lg">Feature Requests</span>
              <span class="text-xs text-muted-foreground">Share Ideas</span>
            </Button>
          </a>
          <a
            href="https://code.cr8-xyz.art/Cr8-xyz/blender/src/branch/webrtc-viewport-streaming/"
            target="_blank"
          >
            <Button
              variant="outline"
              className="h-auto py-4 px-6 flex flex-col items-center justify-center gap-2"
            >
              <span class="text-lg">Custom Blender</span>
              <span class="text-xs text-muted-foreground">WebRTC Build</span>
            </Button>
          </a>
          <a href="https://code.cr8-xyz.art/Cr8-xyz/cr8-app" target="_blank">
            <Button
              variant="outline"
              className="h-auto py-4 px-6 flex flex-col items-center justify-center gap-2"
            >
              <span class="text-lg">Source Code</span>
              <span class="text-xs text-muted-foreground">Repository</span>
            </Button>
          </a>
        </div>
      </div>
    </section>

    <!-- Early Development Notice -->
    <section class="py-24 px-6 relative overflow-hidden">
      <div
        class="absolute inset-0 -z-10"
        style="background: linear-gradient(to bottom, transparent, color-mix(in oklch, var(--secondary) 30%, transparent), transparent);"
      >
      </div>

      <div class="max-w-4xl mx-auto">
        <Card className="p-8 md:p-12 space-y-6 border-primary/30 bg-primary/5">
          <div class="space-y-4">
            <div class="flex items-center gap-3">
              <span class="text-3xl">🎬</span>
              <h3 class="text-2xl md:text-3xl font-semibold">
                Fashion Storytelling
              </h3>
            </div>
            <div class="space-y-4 text-muted-foreground leading-relaxed">
              <p>
                <strong class="text-foreground"
                  >We're building something special.</strong
                >
                A new way for fashion brands to tell their stories through cinematic
                experiences. Cr8-xyz is in early development, so expect occasional
                hiccups along with exciting updates as we perfect the experience.
              </p>
              <p class="text-foreground font-medium">
                <strong>Join us.</strong> Through feedback, community, and code!
              </p>
            </div>
          </div>
        </Card>
      </div>
    </section>
  </main>
</Layout>
